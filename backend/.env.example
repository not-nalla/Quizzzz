# ==============================================================================
# SyllabusIQ Backend Configuration Environment File
# ==============================================================================

# Application & Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local MongoDB or Atlas Connection
# If using MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=syllabusiq_db

# Security & Dual-Token Authentication
JWT_SECRET_KEY=syllabusiq_academic_super_secret_jwt_key_2026_x86_production_grade
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Institutional Faculty Access Gate
TEACHER_INVITE_CODE=INST-STANFORD-2026

# Groq API Key (Used for llama-3.3-70b-versatile quiz generation and doubt AI)
GROQ_API_KEY=

# Google Gemini API Key (Optional secondary provider)
GEMINI_API_KEY=

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Vector Search & RAG Thresholds
EMBEDDING_MODEL=models/embedding-001
LLM_MODEL=llama-3.3-70b-versatile
COSINE_SIMILARITY_CUTOFF=0.30
MAX_CHAT_HISTORY_TURNS=3
STUDENT_HOURLY_RATE_LIMIT=30

# Document Ingestion Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
